{
  "name": "suryashare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "chain": "hardhat node --hostname 127.0.0.1",
    "compile": "node scripts/compile.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test": "node --test tests/contract.test.mjs",
    "test:pages": "node --test tests/pages.test.mjs",
    "test:simulation": "node --test tests/simulation.test.mjs",
    "demo": "vite --mode simulation --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run compile && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "connect:sepolia": "node scripts/connect-sepolia.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "hardhat": "^3.18.0",
    "solc": "0.8.30",
    "vite": "^8.3.1"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
